# Dockerfile.demo
# CPU-only demo image — no GPU needed for the interface itself.
# faster-whisper will auto-detect GPU at runtime if available.

FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies
RUN pip install --no-cache-dir \
    streamlit>=1.35.0 \
    faster-whisper>=1.0.3 \
    openai>=1.0.0 \
    python-dotenv>=1.0.0 \
    reportlab>=4.0.0

# App source
COPY app_demo.py .
COPY prompts.py .

# Folders
RUN mkdir -p audio results dataset transcriptions

EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "app_demo.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--server.fileWatcherType=none"]